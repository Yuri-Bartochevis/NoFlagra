# cp .env.example .env  and generate a real secret:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
RECEIVER_SECRET=change-me-to-something-random

# Password for the manage page (http://<pi>:5001/manage) — deleting clips and
# changing the clip window. Leave it unset and the button key above is used
# instead, but that key is compiled into the ESP32 firmware, so anyone who can
# read the firmware could delete footage. Generate one the same way.
# ADMIN_PASSWORD=

# --- clip window ---
# How far back a press reaches, in seconds. 600 (10 minutes) is the default
# and what the marketing site quotes; set it per gym at install. Frigate must
# have been recording for at least this long before a press can produce a
# full clip, and a longer window means a bigger file to store and upload.
# LOOKBACK_SECONDS=600
# Seconds kept past the press, also how long the receiver waits before asking
# for the export so the trailing segments have reached disk.
# POST_ROLL_SECONDS=15
# Repeat presses inside this window are ignored (bounce, someone leaning on
# the button, the ESP32 retrying a flaky reply).
# COOLDOWN_SECONDS=30

# --- cloud link (optional) ---
# Filled in automatically by:
#   python3 tools/pair_device.py <cloud-url> <pairing-code> <camera-name>...
# Leave these unset and the receiver behaves exactly as it did before the
# cloud existed: it records, exports and serves clips locally, and just
# doesn't register them anywhere.
# CLOUD_URL=https://noflagra.example
# DEVICE_UUID=
# DEVICE_KEY=
